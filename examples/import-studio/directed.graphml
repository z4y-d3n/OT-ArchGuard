<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="label" for="node" attr.name="label" attr.type="string" /><key id="role" for="node" attr.name="role" attr.type="string" /><key id="load" for="node" attr.type="double"><default>0.10000000000000001</default></key><graph id="plant" edgedefault="directed"><node id="eng"><data key="label">Engineering workstation</data><data key="role">Engineering</data></node><node id="fw"><data key="label">Industrial firewall</data><data key="role">Boundary</data></node><node id="sw"><data key="label">Managed switch</data><data key="role">Switch</data></node><node id="plc"><data key="label">PLC</data><data key="role">Controller</data></node><node id="hmi"><data key="label">HMI</data><data key="role">Operator</data></node><node id="hist"><data key="label">Historian</data><data key="role">Historian</data></node><edge id="e0" source="eng" target="fw" /><edge id="e1" source="fw" target="sw" /><edge id="e2" source="sw" target="plc" /><edge id="e3" source="plc" target="hmi" /><edge id="e4" source="hmi" target="hist" /></graph></graphml>
